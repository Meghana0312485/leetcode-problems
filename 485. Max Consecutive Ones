class Solution(object):
    def findMaxConsecutiveOnes(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        current_count=0
        max_count=0
        for i in nums:
            if i==1:
                current_count+=1
                max_count=max(max_count, current_count)
            else:
                current_count=0
        return max_count
        
