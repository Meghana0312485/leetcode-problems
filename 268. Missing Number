class Solution(object):
    def missingNumber(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
       
        m=len(nums)
        expect_sum=(m*(m+1))//2
        actual=sum(nums)
        return expect_sum-actual



**xor method**
class Solution(object):
    def missingNumber(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        n=len(nums)
        xor_all=0
        xor_nums=0
        for i in range(1,n+1):
            xor_all^=i
        for num in nums:
            xor_nums^=num
        return xor_all^xor_nums
      
        
