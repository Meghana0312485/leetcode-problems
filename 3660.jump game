class Solution(object):
    def maxValue(self, nums):
        """
        :type nums: List[int]
        :rtype: List[int]
        """
        
        n = len(nums)

        
        pre_max = [0] * n
        pre_max[0] = nums[0]

        for i in range(1, n):
            pre_max[i] = max(pre_max[i - 1], nums[i])

        ans = [0] * n
        suf_min = float('inf')

        
        for i in range(n - 1, -1, -1):

            if pre_max[i] > suf_min:
                ans[i] = ans[i + 1] if i + 1 < n else pre_max[i]
            else:
                ans[i] = pre_max[i]

            suf_min = min(suf_min, nums[i])

        return ans
        
