class Solution(object):
    def maxPower(self, s):
        """
        :type s: str
        :rtype: int
        """
    
        current=1
        maxlen=1
        if not s:
            return 0
        for i in range(1,len(s)):
            if s[i]==s[i-1]:
                current+=1
                maxlen=max(maxlen, current)
            else:
                current=1
        return maxlen
        
