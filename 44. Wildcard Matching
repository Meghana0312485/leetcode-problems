class Solution(object):
    def isMatch(self, s, p):
        """
        :type s: str
        :type p: str
        :rtype: bool
        """
        
        i = j = 0
        star = -1
        match = 0

        while i < len(s):

            # Characters match or '?'
            if j < len(p) and (p[j] == s[i] or p[j] == '?'):
                i += 1
                j += 1

            # Found '*'
            elif j < len(p) and p[j] == '*':
                star = j
                match = i
                j += 1

            # Backtrack to last '*'
            elif star != -1:
                j = star + 1
                match += 1
                i = match

            else:
                return False

        # Remaining characters in pattern should all be '*'
        while j < len(p) and p[j] == '*':
            j += 1

        return j == len(p)
        
