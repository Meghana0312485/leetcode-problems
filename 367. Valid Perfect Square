class Solution(object):
    def isPerfectSquare(self, num):
        """
        :type num: int
        :rtype: bool
        """
        if num<2:
            return True
        left=2
        right=num//2
        while(left<=right):
            mid=(left+right)//2
            x=mid*mid
            if x==num:
                return True
            elif x<num:
                left=mid+1
            else:
                right=mid-1
        return False


        
